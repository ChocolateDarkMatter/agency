---
import Layout from "../layouts/Layout.astro";
import { Hero } from "@modules/Hero";
import { Button } from "@components/Button";
import { Container } from "@components/Container";
import { FadeIn } from "@utils/animations/FadeIn";
import { fetchGalleryImages, generateImageUrl, type CloudinaryImage } from "@utils/cloudinary";
import "@fancyapps/ui/dist/fancybox/fancybox.css";

// Fetch images from Cloudinary
let images: CloudinaryImage[] = [];
try {
  images = await fetchGalleryImages();
} catch (error) {
  console.error('Failed to fetch gallery images:', error);
  // Fallback to empty array if Cloudinary fails
  images = [];
}
---

<Layout
    title="Gallery | Setup & Smile - Houston Event Rentals"
    description="View our gallery of successful events and premium rental inventory. See how Setup & Smile transforms Houston weddings, corporate events, and celebrations."
>
    <main class="page-content">
        <Hero heroType="center" client:load>
            <FadeIn delay={0.2} client:load>
                <h1>Our Gallery</h1>
                <p>Explore our collection of successful events and premium rental inventory</p>
            </FadeIn>
        </Hero>
        
        <Container>
            <div class="gallery-navigation">
                <Button variant="secondary" link="/">
                    ← Back to Home
                </Button>
                <Button variant="primary" link="/contact">
                    Contact Us →
                </Button>
            </div>
        </Container>

        <section class="justified-gallery" id="photoswipe">
            {images.length > 0 ? (
                images.map((image, index) => {
                    const thumbnailUrl = generateImageUrl(image.public_id, {
                        width: 400,
                        height: 400,
                        crop: 'fill',
                        quality: 'auto',
                        format: 'webp'
                    });
                    
                    const fullSizeUrl = generateImageUrl(image.public_id, {
                        quality: 'auto',
                        format: 'webp'
                    });
                    
                    return (
                        <a
                            style={`--width: ${image.width}; --height: ${image.height}; --index: ${index};`}
                            href={fullSizeUrl}
                            target="_blank"
                            data-fancybox="gallery"
                        >
                            <img
                                src={thumbnailUrl}
                                alt="Event rental showcase"
                                loading={index < 12 ? "eager" : "lazy"}
                                width="400"
                                height="400"
                            />
                        </a>
                    );
                })
            ) : (
                <div class="no-images">
                    <p>No images found in gallery. Please check your Cloudinary configuration.</p>
                </div>
            )}
        </section>
    </main>
</Layout>

<script>
    import { Fancybox } from "@fancyapps/ui/dist/fancybox/";

    Fancybox.bind("[data-fancybox]", {
        theme: "auto",
        mainStyle: {
            "--f-button-width": "44px",
            "--f-button-height": "44px",
            "--f-button-border-radius": "50%",
            "--f-toolbar-padding": "16px",
        },
        Carousel: {
            Arrows: false,
            Toolbar: {
                display: {
                    left: [],
                    middle: [],
                    right: ["close"],
                },
            },
            transition: "slide",
        },
    });
</script>

<style>
    .gallery-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 2rem 0;
        gap: 1rem;
    }

    @media (max-width: 768px) {
        .gallery-navigation {
            flex-direction: column;
            gap: 1rem;
        }
        
        .gallery-navigation > * {
            width: 100%;
            text-align: center;
        }
    }

    .justified-gallery {
        --padding: max(2.5vw, 12px);
        --space: max(2.5vw, 12px);
        --min-height: clamp(200px, 20vw, 400px);

        padding: var(--padding);
        display: flex;
        flex-wrap: wrap;
        gap: var(--space);

        a {
            flex-grow: calc(var(--width) * (100000 / var(--height)));
            flex-basis: calc(var(--min-height) * (var(--width) / var(--height)));
            aspect-ratio: var(--width) / var(--height);
            overflow: hidden;
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            border-radius: 8px;
            animation: fadeInUp 0.6s ease-out forwards;
        }
        
        a:nth-child(n) {
            animation-delay: calc(0.1s * var(--index, 0));
        }

        a img {
            display: block;
            object-fit: cover;
            height: 100%;
            width: 100%;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            will-change: transform;
        }

        a:hover img {
            transform: scale(1.08);
        }
        
        a:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

        a:focus-visible {
            outline: 3px solid var(--primary-color, #007bff);
            outline-offset: 2px;
            transform: scale(1.05);
            z-index: 1;
            border-radius: 2px;
            box-shadow: 0 2px 4px 2px rgba(0, 0, 0, 0.1);
        }

        a.hidden {
            transition: opacity 0.4s ease-in-out;
            opacity: 0;
        }

        &::after {
            content: " ";
            flex-grow: 1000000000;
        }
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .no-images {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 200px;
        text-align: center;
        color: var(--text-secondary, #666);
        font-size: 18px;
    }
</style>