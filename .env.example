# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=your_folder_name_here

# EmailJS Configuration
# Get these values from your EmailJS dashboard
PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here
PUBLIC_EMAILJS_SERVICE_ID=your_service_id_here

# Template IDs for different contexts
PUBLIC_EMAILJS_ADMIN_TEMPLATE_CONTACT=your_admin_contact_template_id
PUBLIC_EMAILJS_USER_TEMPLATE_CONTACT=your_user_contact_template_id
PUBLIC_EMAILJS_ADMIN_TEMPLATE_OFFERS=your_admin_offers_template_id
PUBLIC_EMAILJS_USER_TEMPLATE_OFFERS=your_user_offers_template_id

# Feature Flags
PUBLIC_CONTACT_MODE=emailjs
# Options: 'emailjs' for normal operation, 'off' for disabled with fallback

# Cloudflare Turnstile (CAPTCHA) - Optional
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Domain Configuration
PUBLIC_ALLOWED_DOMAINS=localhost,setupandsmile.com,*.setupandsmile.com